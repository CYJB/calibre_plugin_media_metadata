# --- comparison table: tooltips ----------------------------------------------

msgid "Writing this clears the existing date tag."
msgstr "写入将清空文件中已有的日期标签。"

msgid "Writing this clears the existing tag."
msgstr "写入将清空文件中已有的标签。"

msgid "The file also carries %s; only %s will be written."
msgstr "文件中还带有 %s；只会写入 %s。"

msgid "ffmpeg has no standard tag for this field; it cannot be written to media files."
msgstr "ffmpeg 没有此字段对应的标准标签，无法写入媒体文件。"

msgid "ffmpeg cannot store cover art in .%s containers."
msgstr "ffmpeg 无法在 .%s 容器中存储封面。"

msgid "Writing this removes the existing cover art."
msgstr "写入将移除文件中已有的封面。"

msgid "Derived from the stream; not a writable tag."
msgstr "由媒体流推导得出，不是可写入的标签。"

# --- customization_help (calibre uses it to decide whether a plugin is configurable)

msgid "Paths to ffmpeg and ffprobe (leave blank to auto-detect), plus the custom column that should hold the media duration and its datatype."
msgstr "ffmpeg 和 ffprobe 的路径（留空则自动检测），以及用于存放媒体时长的自定义列及其数据类型。"

msgid "Paths to ffmpeg and ffprobe (leave blank to auto-detect), the ID3 version written to mp3 files, whether to write cover art, whether to add the action to the book list right-click menu, and the mapping from calibre custom columns to tag keys."
msgstr "ffmpeg 和 ffprobe 的路径（留空则自动检测）、写入 mp3 文件的 ID3 版本、是否写入封面、是否将此操作加入书籍列表右键菜单，以及 calibre 自定义列到标签键的映射。"

# --- ffmpeg/ffprobe 出错提示（binaries.tool_error_text 按 ToolError.kind 组装）---------

msgid "Cannot find %s. Install it, or set the full path in the plugin settings."
msgstr "找不到 %s。请安装它，或在插件设置里填写完整路径。"

msgid "%s cannot be run: %s"
msgstr "无法运行 %s：%s"

msgid "%s did not respond within %s seconds."
msgstr "%s 超过 %s 秒没有响应。"

msgid "%s exited with code %s."
msgstr "%s 运行失败，退出码 %s。"

msgid "Its output was:"
msgstr "它的输出是："

# --- 反方向：用文件更新书库（对比对话框里的按钮）------------------------------

msgid "Update library from the files"
msgstr "用文件中的元数据更新书库"

msgid "Read the tags in these media files and write the checked fields into the calibre metadata of the same books."
msgstr "读取这些媒体文件里的标签，把勾选的字段写进同一本书的 calibre 元数据。"

msgid "Update file metadata"
msgstr "更新文件元数据"

msgid "Sync to library only"
msgstr "仅同步回书库"

msgid "Only written back to the library: the duration comes from the media stream, so there is no tag to write into the file."
msgstr "只写回书库：时长来自媒体流本身，文件里没有可写的标签。"

msgid "Update library from files"
msgstr "用文件更新书库"

msgid "Nothing to update"
msgstr "没有可更新的内容"

msgid "The media files do not carry any metadata that differs from the library."
msgstr "这些媒体文件里没有与书库不同的元数据。"

msgid "Use the files to update {} book?"
msgid_plural "Use the files to update {} books?"
msgstr[0] "用文件里的元数据更新 {} 本书？"

msgid "{} field will be overwritten by the value from the file."
msgid_plural "{} fields will be overwritten by the values from the files."
msgstr[0] "{} 个字段会被文件里的值覆盖。"

msgid "Library updated"
msgstr "书库已更新"

msgid "Updated {} book."
msgid_plural "Updated {} books."
msgstr[0] "已更新 {} 本书。"

