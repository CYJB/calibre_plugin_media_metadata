# --- plugin descriptions -----------------------------------------------------

msgid "Read title, authors, series, tags, comments, publisher, date, cover art and duration from audio and video files (mp3, m4a, m4b, mp4, mkv, flac, ogg, opus, mov, webm and more) using ffprobe. Requires ffmpeg/ffprobe to be installed."
msgstr "使用 ffprobe 从音频和视频文件（mp3、m4a、m4b、mp4、mkv、flac、ogg、opus、mov、webm 等）中读取书名、作者、系列、标签、简介、出版社、出版日期、封面和时长。需要已安装 ffmpeg/ffprobe。"

msgid "Add a right-click menu entry that compares the metadata in the calibre library against the tags currently embedded in a book's audio/video files, and writes the fields you tick back into the files using ffmpeg."
msgstr "在右键菜单中新增一项，把 calibre 书库里的元数据与书籍音视频文件中当前内嵌的标签进行对比，并用 ffmpeg 把你勾选的字段写回文件。"

# --- menu / action -----------------------------------------------------------

msgid "Compare and write media metadata…"
msgstr "对比并写入媒体元数据…"

msgid "Compare and write media metadata"
msgstr "对比并写入媒体元数据"

msgid "Compare the calibre metadata with the tags inside audio/video files, then write the fields you tick back into the files"
msgstr "将 calibre 中的元数据与音视频文件内的标签进行对比，然后把你勾选的字段写回文件"

msgid "Media metadata"
msgstr "媒体元数据"

msgid "No books selected"
msgstr "未选择书籍"

msgid "Select one or more books first."
msgstr "请先选择一本或多本书籍。"

msgid "ffmpeg not found"
msgstr "未找到 ffmpeg"

msgid "This action needs both ffmpeg and ffprobe.\n\nInstall them, or set their paths in Preferences → Plugins → “Sync media metadata” → Customize."
msgstr "此操作同时需要 ffmpeg 和 ffprobe。\n\n请安装它们，或在「首选项 → 插件 → “Sync media metadata” → 自定义」中设置它们的路径。"

msgid "No media files"
msgstr "没有媒体文件"

msgid "None of the selected books have an audio or video format.\n\nSupported: %s"
msgstr "所选书籍都没有音频或视频格式。\n\n支持的格式：%s"

msgid "Reading media metadata…"
msgstr "正在读取媒体元数据…"

msgid "Writing media metadata…"
msgstr "正在写入媒体元数据…"

msgid "Cancel"
msgstr "取消"

msgid "Some files could not be read"
msgstr "部分文件无法读取"

msgid "Could not read media metadata"
msgstr "无法读取媒体元数据"

msgid "Unknown error"
msgstr "未知错误"

msgid "Nothing to write"
msgstr "没有需要写入的内容"

msgid "No fields were ticked, so no files were changed."
msgstr "没有勾选任何字段，因此未修改任何文件。"

msgid "Problems:"
msgstr "问题："

msgid "Cancelled after {} file."
msgid_plural "Cancelled after {} files."
msgstr[0] "已在写入 {} 个文件后取消。"

msgid "Wrote metadata into {} file."
msgid_plural "Wrote metadata into {} files."
msgstr[0] "已将元数据写入 {} 个文件。"

msgid "{} file had tracks that the new file cannot hold; they were skipped."
msgid_plural "{} files had tracks that the new file cannot hold; they were skipped."
msgstr[0] "有 {} 个文件里存在新文件放不下的轨道，已跳过这些轨道（其余元数据照常写入）。"

msgid "Skipped tracks:"
msgstr "已跳过的轨道："

