# --- ffmpeg/ffprobe configuration -------------------------------------------

msgid "ffmpeg path:"
msgstr "ffmpeg 路径："

msgid "ffprobe path:"
msgstr "ffprobe 路径："

msgid "Auto-detect"
msgstr "自动检测"

msgid "Browse…"
msgstr "浏览…"

msgid "Test"
msgstr "测试"

msgid "Choose %s"
msgstr "选择 %s"

msgid "All files"
msgstr "所有文件"

msgid "Not found"
msgstr "未找到"

msgid "%s could not be located. Install it, or type the full path above."
msgstr "未能找到 %s。请安装它，或在上方填写完整路径。"

msgid "Failed"
msgstr "失败"

msgid "Found"
msgstr "已找到"

msgid "not found"
msgstr "未找到"

msgid "These paths are shared by both media metadata plugins, so they only have to be set once. Leave blank to auto-detect. Detection checks your PATH and the usual install locations (Homebrew on macOS; C:\\ffmpeg, Program Files, WinGet, Chocolatey and Scoop on Windows). A GUI calibre does not inherit your shell PATH, so setting the path explicitly is the most reliable option."
msgstr "这两个路径由两个媒体元数据插件共用，只需设置一次。留空则自动检测。检测会查找 PATH 以及常见安装位置（macOS 的 Homebrew；Windows 的 C:\\ffmpeg、Program Files、WinGet、Chocolatey 和 Scoop）。以图形界面启动的 calibre 不会继承 shell 的 PATH，因此手动填写路径最为可靠。"

# --- reader configuration ----------------------------------------------------

msgid "Duration column:"
msgstr "时长列："

msgid "Duration column datatype:"
msgstr "时长列数据类型："

msgid "The media duration is stored in a calibre custom column, because calibre has no built-in duration field. Create the column first (Preferences → Add your own columns), then enter its lookup name here, e.g. #duration.\n\nThe datatype must match the column you created exactly — calibre silently ignores the value if it does not. Leave the column name blank to skip duration."
msgstr "媒体时长存放在 calibre 的自定义列中，因为 calibre 没有内置的时长字段。请先创建该列（首选项 → 添加你自己的列），然后在此填写它的检索名，例如 #duration。\n\n数据类型必须与你创建的列完全一致——不一致时 calibre 会静默忽略该值。列名留空则不处理时长。"

# --- sync configuration ------------------------------------------------------

msgid "ID3 version for mp3:"
msgstr "mp3 的 ID3 版本："

msgid "v2.3 is understood by the widest range of players and hardware; v2.4 stores UTF-8 tags natively."
msgstr "v2.3 的兼容性最好，绝大多数播放器和硬件都支持；v2.4 原生以 UTF-8 存储标签。"

msgid "Write cover art into the media files"
msgstr "将封面写入媒体文件"

msgid "Add this action to the book list right-click menu automatically"
msgstr "自动将此操作加入书籍列表右键菜单"

msgid "The entry appears in the right-click menu after the next calibre restart. Turn this off to place the action yourself in Preferences → Toolbars → “The context menu for the books in the calibre library”."
msgstr "该菜单项会在下次重启 calibre 后出现在右键菜单中。关闭此项后，你可以自行在「首选项 → 工具栏 → “calibre 书库中书籍的右键菜单”」中摆放该操作。"

msgid "Custom columns to sync:"
msgstr "要同步的自定义列："

msgid "Lookup name"
msgstr "检索名"

msgid "Label"
msgstr "名称"

msgid "Tag key"
msgstr "标签键"

msgid "Add column"
msgstr "添加列"

msgid "Remove column"
msgstr "移除列"

msgid "Map a calibre custom column to a tag key, e.g. #narrator → album_artist. The lookup name is the one shown in Preferences → Add your own columns, with or without the leading #. Tag keys are ffmpeg names such as artist, album, genre, comment, date, publisher, album_artist, composer, isbn."
msgstr "把 calibre 的自定义列映射到标签键，例如 #narrator → album_artist。检索名就是「首选项 → 添加你自己的列」中显示的那个，带不带开头的 # 都可以。标签键使用 ffmpeg 的名称，例如 artist、album、genre、comment、date、publisher、album_artist、composer、isbn。"

